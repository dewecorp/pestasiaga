Options -Indexes -MultiViews

RewriteEngine On

# Hilangkan index.php dari URL (GET/HEAD saja)
RewriteCond %{REQUEST_METHOD} !=POST
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.php[?\s] [NC]
RewriteRule ^(.*/)?index\.php$ /$1 [R=302,L]

# Hilangkan ekstensi .php dari URL (GET/HEAD saja)
RewriteCond %{REQUEST_METHOD} !=POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[?\s] [NC]
RewriteRule ^(.+?)\.php$ /$1 [R=302,L]

# Akses tanpa ekstensi: /path -> /path.php (internal rewrite, aman untuk GET/POST)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<Files "config/koneksi.php">
    Order allow,deny
    Deny from all
</Files>

<Files "*.sql">
    Order allow,deny
    Deny from all
</Files>
